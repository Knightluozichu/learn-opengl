    {
      "type": "text",
      "id": "t_s_mvp",
      "x": 20,
      "y": 172,
      "width": 350,
      "height": 85,
      "text": "MVP 三矩阵计算:\n\nmodel  = rotate(mat4(1), time, axis)     → 对象→世界\nview   = translate(mat4(1), (0,0,-3))    → 世界→观察\nproj   = perspective(45°, 800/600, 0.1, 100)  → 观察→裁剪\n\nourShader.setMat4 逐个上传",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "s_mvp",
      "originalText": "MVP 三矩阵计算:\n\nmodel  = rotate(mat4(1), time, axis)     → 对象→世界\nview   = translate(mat4(1), (0,0,-3))    → 世界→观察\nproj   = perspective(45°, 800/600, 0.1, 100)  → 观察→裁剪\n\nourShader.setMat4 逐个上传",
      "autoResize": true,
