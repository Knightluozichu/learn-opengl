    {
      "type": "text",
      "id": "t_s_cam",
      "x": 20,
      "y": 250,
      "width": 350,
      "height": 55,
      "text": "Camera 类内部:\nyaw/pitch → updateCameraVectors()\n→ front = (cos y·cos p, sin p, sin y·cos p)\n→ right = front × worldUp\n→ up = right × front\n\ngetViewMatrix() = lookAt(pos, pos+front, up)",
      "fontSize": 11,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "s_cam",
      "originalText": "Camera 类内部: yaw/pitch → updateCameraVectors() → front = (cos y·cos p, sin p, sin y·cos p) → right = front × worldUp → up = right × front getViewMatrix() = lookAt(pos, pos+front, up)",
      "autoResize": true,
