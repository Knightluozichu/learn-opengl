    {
      "type": "text",
      "id": "t_s_loop",
      "x": 20,
      "y": 427,
      "width": 350,
      "height": 55,
      "text": "每帧渲染循环:\n1. deltaTime = curTime - lastTime\n2. processInput(camera, dt)\n3. view = camera.getViewMatrix()\n4. proj = perspective(zoom, W/H, 0.1, 100)\n5. for i in 0..99: model = T(cubePos[i]) * R(angle+i)\n   → setMat4(model) → glDrawElements",
      "fontSize": 11,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "s_loop",
      "originalText": "每帧渲染循环: 1. deltaTime = curTime - lastTime 2. processInput(camera, dt) 3. view = camera.getViewMatrix() 4. proj = perspective(zoom, W/H, 0.1, 100) 5. for i in 0..99: model = T(cubePos[i]) * R(angle+i) → setMat4(model) → glDrawElements",
      "autoResize": true,
      "version": 2,
      "versionNonce": 577464870,
